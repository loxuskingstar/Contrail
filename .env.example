# Copiez ce fichier en .env puis ajustez. Toutes les variables sont facultatives.

# Mot de passe d'accès (laisser vide = pas d'authentification : réservé au réseau local / Tailscale / VPN)
CONTRAIL_PASSWORD=

# Port publié sur l'hôte et fuseau horaire du conteneur
CONTRAIL_PORT=8000
TZ=Europe/Paris

# UID/GID propriétaires du dossier ./data sur l'hôte (sortie de `id -u` / `id -g`)
UID=1000
GID=1000

# --- API externes gratuites (peuvent aussi être saisies dans Réglages › Intégrations) ---
# https://airlabs.co/signup — remplissage auto (MSN, Mode-S) et flottes complètes
AIRLABS_API_KEY=
# https://aviationstack.com/signup/free — source complémentaire (expérimental)
AVIATIONSTACK_API_KEY=
# https://opensky-network.org — client API (OAuth2) pour augmenter le quota du radar
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# --- Notifications externes ---
# ex. https://ntfy.sh/un-sujet-difficile-a-deviner (ou votre serveur ntfy)
NTFY_URL=
# Webhook appelé en POST JSON {kind, title, body, link}
WEBHOOK_URL=
# Adresse publique de l'instance, pour les liens de partage et les notifications
PUBLIC_BASE_URL=

# Désactive tout appel réseau sortant (tests, environnement isolé)
# CONTRAIL_OFFLINE=1
# LOG_LEVEL=INFO
